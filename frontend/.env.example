# Copy to .env for local development; on Vercel set these in Project Settings.
# Create React App only exposes variables that start with REACT_APP_.

# Backend base URL (no trailing slash)
REACT_APP_BACKEND_URL=http://localhost:9000

# Credentials used by the "Try demo" button. These ship in the public bundle,
# so use only the throwaway demo account created by `npm run seed:demo`.
REACT_APP_DEMO_EMAIL=demo.gsec@example.com
REACT_APP_DEMO_PASSWORD=LHDemo@2026
