# Copy to .env for local development. On Vercel, add the same keys under
# Project Settings -> Environment Variables. Never commit the real .env.

# MongoDB connection string (use a dedicated demo database)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lh-demo?retryWrites=true&w=majority

# Long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=change-me
SESSION_SECRET=change-me-too

# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Vercel Cron sends this as "Authorization: Bearer ..." to /deleteUnwanted
CRON_SECRET=change-me-as-well

# Public signup lets callers pick any role, so leave this off (or false) on the public deployment
ALLOW_SIGNUP=false

# Optional: override the demo account created by `npm run seed:demo`
# DEMO_EMAIL=demo.gsec@example.com
# DEMO_PASSWORD=LHDemo@2026

# Local only (Vercel sets the port itself)
PORT=9000
